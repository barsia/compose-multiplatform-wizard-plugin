<idea-plugin>
  <!-- This file is loaded ONLY in Android Studio (when org.jetbrains.android is available) -->
  
  <depends>org.jetbrains.kotlin</depends>
  
  <!-- Mark plugin as K2-compatible -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  
  <!-- 
    DISABLED to keep wizard entry points action-based.
    
    These extension points are NOT needed because we have Actions (File → New, Welcome Screen)
    that provide the same functionality with better user experience.
    
    Benefits of disabling:
    - ✅ Actions still work perfectly (File → New, Welcome Screen)
    - ✅ Same beautiful Compose UI
    - ✅ Less code to maintain
    
    What's disabled:
    - ❌ Template in standard Android Studio gallery (Phone and Tablet)
    - ❌ Module builder (we don't support adding modules to existing projects anyway)
  -->
  <!--
  <extensions defaultExtensionNs="com.android.tools.idea.wizard.template">
    <wizardTemplateProvider implementation="io.github.barsia.composewizard.androidstudio.ComposeMultiplatformTemplateProvider"/>
  </extensions>
  
  <extensions defaultExtensionNs="com.intellij">
    <moduleBuilder builderClass="io.github.barsia.composewizard.androidstudio.project.ComposeMultiplatformProjectBuilder" order="first"/>
  </extensions>
  -->
  
  <!-- Welcome Screen tooltip listener -->
  <applicationListeners>
    <listener class="io.github.barsia.composewizard.androidstudio.WelcomeScreenTooltipListener" 
              topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>
  
  <!-- 
    Additional actions for Android Studio
    These appear in:
    - File -> New -> Compose Multiplatform Project
    - Welcome Screen -> Compose Multiplatform Project
  -->
  <actions>
    <action id="ComposeMultiplatform.NewProject.AS"
            class="io.github.barsia.composewizard.androidstudio.AndroidStudioComposeWizardAction"
            text="Compose Multiplatform Project..."
            description="Create a new Compose Multiplatform project with advanced Compose UI"
            icon="/META-INF/compose.svg">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewProject"/>
    </action>
    
    <action id="ComposeMultiplatform.WelcomeScreen.AS"
            class="io.github.barsia.composewizard.androidstudio.AndroidStudioComposeWizardAction"
            text="Compose Multiplatform Project"
            description="Create a new Compose Multiplatform project with advanced Compose UI"
            icon="/META-INF/compose.svg">
      <add-to-group group-id="WelcomeScreen.QuickStart" anchor="after" relative-to-action="WelcomeScreen.CreateNewProject"/>
    </action>
  </actions>
</idea-plugin>
