<idea-plugin>
  <!-- This file is loaded ONLY in Android Studio (when org.jetbrains.android is available) -->
  
  <depends>org.jetbrains.kotlin</depends>
  
  <!-- Mark plugin as K2-compatible -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  
  <!-- Android Studio wizard integration - appears in "Phone and Tablet" section -->
  <extensions defaultExtensionNs="com.android.tools.idea.wizard.template">
    <wizardTemplateProvider implementation="io.github.heisiar.composewizard.androidstudio.ComposeMultiplatformTemplateProvider"/>
  </extensions>
  
  <!-- 
    Custom New Module wizard with full UI control (no Groovy, no Java, all params on one screen)
    
    TODO: Temporarily disabled until we understand the correct logic for adding modules to existing projects.
    The module creation logic needs to be properly integrated with Gradle sync and project structure.
  -->
  <!--
  <extensions defaultExtensionNs="com.android">
    <moduleDescriptionProvider implementation="io.github.heisiar.composewizard.androidstudio.module.ComposeMultiplatformModuleDescriptionProvider"/>
  </extensions>
  -->
  
  <!-- Custom New Project wizard with Compose UI (appears in New Project dialog) -->
  <extensions defaultExtensionNs="com.intellij">
    <moduleBuilder builderClass="io.github.heisiar.composewizard.androidstudio.project.ComposeMultiplatformProjectBuilder" order="first"/>
  </extensions>
  
  <!-- Welcome Screen tooltip listener -->
  <applicationListeners>
    <listener class="io.github.heisiar.composewizard.androidstudio.WelcomeScreenTooltipActivity" topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>
  
  <!-- 
    Additional actions for Android Studio
    These appear in:
    - File -> New -> Compose Multiplatform Project
    - Welcome Screen -> Compose Multiplatform Project
  -->
  <actions>
    <action id="ComposeMultiplatform.NewProject.AS"
            class="io.github.heisiar.composewizard.androidstudio.AndroidStudioComposeWizardAction"
            text="Compose Multiplatform Project..."
            description="Create a new Compose Multiplatform project with advanced Compose UI"
            icon="/META-INF/compose.svg">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewProject"/>
    </action>
    
    <action id="ComposeMultiplatform.WelcomeScreen.AS"
            class="io.github.heisiar.composewizard.androidstudio.AndroidStudioComposeWizardAction"
            text="Compose Multiplatform Project"
            description="Create a new Compose Multiplatform project with advanced Compose UI"
            icon="/META-INF/compose.svg">
      <add-to-group group-id="WelcomeScreen.QuickStart" anchor="after" relative-to-action="WelcomeScreen.CreateNewProject"/>
    </action>
  </actions>
</idea-plugin>

