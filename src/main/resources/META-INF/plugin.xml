<idea-plugin allow-bundled-update="true">
  <id>io.github.heisiar.compose-multiplatform-wizard</id>
  <name>Compose Multiplatform Wizard</name>
  <vendor email="heisiar@example.com">heisiar</vendor>
  
  <description><![CDATA[
    <strong>Universal Compose Multiplatform Project Wizard</strong><br><br>
    Works seamlessly in both <strong>IntelliJ IDEA</strong> and <strong>Android Studio</strong>!<br><br>
    
    <h3>Features:</h3>
    <ul>
      <li>Create multi-platform projects for Desktop, Android, iOS, and Web</li>
      <li>Smart platform detection and adaptation</li>
      <li>Modern project templates with best practices</li>
      <li>Version selection for Compose Multiplatform</li>
    </ul>
    
    <h3>Supported Platforms:</h3>
    <ul>
      <li>Desktop (JVM): Windows, macOS, Linux</li>
      <li>Android: Native Android apps</li>
      <li>iOS: Native iOS apps (via Kotlin/Native)</li>
      <li>Web: Browser-based apps (via Kotlin/Wasm & Kotlin/JS)</li>
    </ul>
    
    <br>
    <p>For support, please use the plugin's page on JetBrains Marketplace.</p>
  ]]></description>
  
  <!-- Base platform module - available in both IntelliJ IDEA and Android Studio -->
  <depends>com.intellij.modules.platform</depends>
  
  <!-- Base dependency - available everywhere -->
  <depends>org.jetbrains.kotlin</depends>
  
  <!-- OPTIONAL: Compose Desktop UI (only available in IntelliJ IDEA) -->
  <depends optional="true">com.intellij.modules.compose</depends>
  
  <!-- OPTIONAL: Android Studio support -->
  <!-- This config file is loaded ONLY when org.jetbrains.android is available -->
  <depends optional="true" config-file="plugin-android.xml">org.jetbrains.android</depends>
  
  <!-- K2 Kotlin compiler support -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  
  <!-- Extensions for IntelliJ IDEA (always loaded) -->
  <extensions defaultExtensionNs="com.intellij">
    <!-- New Project Wizard generator - supports dynamic plugin loading! -->
    <newProjectWizard.generator 
      implementation="io.github.heisiar.composewizard.idea.ComposeMultiplatformGeneratorNewProjectWizard"/>
    
    <!-- Application-level service for caching Compose versions -->
    <applicationService 
      serviceImplementation="io.github.heisiar.composewizard.shared.services.ComposeVersionCache"/>
  </extensions>
</idea-plugin>

