<idea-plugin allow-bundled-update="true">
  <id>io.github.heisiar.compose-multiplatform-wizard</id>
  <name>Compose Multiplatform Wizard</name>
  <vendor url="https://github.com/heisiar">heisiar</vendor>
  
  <description><![CDATA[
    <p>
      A project wizard for creating <strong>Compose Multiplatform</strong> applications.
      Works in <strong>IntelliJ IDEA 2025.3+</strong> and <strong>Android Studio (build 253+)</strong>.
    </p>
    
    <h3>Features:</h3>
    <ul>
      <li><strong>Creates ready-to-run projects</strong> with Gradle configuration for selected platforms</li>
      <li><strong>Automatically resolves library versions</strong> from Maven Central based on Compose version</li>
      <li><strong>Generates platform-specific code</strong> (Android manifest, iOS Xcode project, Desktop main, Web resources)</li>
      <li><strong>Sets up optional features</strong> like Git repository, test scaffolding, and Hot Reload</li>
    </ul>
    
    <h3>Supported Target Platforms:</h3>
    <ul>
      <li><strong>Desktop (JVM):</strong> Windows, macOS, Linux applications</li>
      <li><strong>Android:</strong> Native Android apps with Material Design</li>
      <li><strong>iOS:</strong> Native iOS apps via Kotlin/Native (requires macOS with Xcode)</li>
      <li><strong>Web:</strong> Browser apps via Kotlin/Wasm or Kotlin/JS</li>
    </ul>
    
    <p>
      <strong>License:</strong> Proprietary. <a href="https://github.com/heisiar/compose-multiplatform-wizard-project/blob/main/EULA.md">EULA</a>
    </p>
    
    <p>
      <strong>Privacy:</strong> This plugin collects anonymous usage statistics with your explicit consent to help improve the user experience.
      No personal data is collected. You can opt-out anytime in Settings.
      <a href="https://github.com/heisiar/compose-multiplatform-wizard-project/blob/main/PRIVACY.md">Privacy Policy</a>
    </p>
    
    <p>
      <a href="https://github.com/heisiar/compose-multiplatform-wizard-project/issues/new?template=bug_report.yml">Report a bug</a> | 
      <a href="https://github.com/heisiar/compose-multiplatform-wizard-project/issues/new?template=feature_request.yml">Request a feature</a>
    </p>
  ]]></description>
  
  <!-- Base platform module - available in both IntelliJ IDEA and Android Studio -->
  <depends>com.intellij.modules.platform</depends>
  
  <!-- Base dependency - available everywhere -->
  <depends>org.jetbrains.kotlin</depends>
  
  <!-- Compose Desktop UI -->
  <depends>com.intellij.modules.compose</depends>
  
  <!-- OPTIONAL: Android Studio support -->
  <!-- This config file is loaded ONLY when org.jetbrains.android is available -->
  <depends optional="true" config-file="plugin-android.xml">org.jetbrains.android</depends>
  
  <!-- K2 Kotlin compiler support -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  
  <!-- Extensions for IntelliJ IDEA (always loaded) -->
  <extensions defaultExtensionNs="com.intellij">
    <!-- New Project Wizard generator - supports dynamic plugin loading! -->
    <newProjectWizard.generator 
      implementation="io.github.heisiar.composewizard.idea.ComposeMultiplatformGeneratorNewProjectWizard"/>
    
    <!-- Application-level service for caching Compose versions -->
    <applicationService 
      serviceImplementation="io.github.heisiar.composewizard.shared.services.ComposeVersionCache"/>
    
    <!-- Analytics service (Google Analytics with user consent) -->
    <applicationService 
      serviceImplementation="io.github.heisiar.composewizard.shared.analytics.AnalyticsService"/>
    
    <!-- Settings UI -->
    <applicationConfigurable 
      parentId="tools"
      instance="io.github.heisiar.composewizard.shared.settings.WizardSettingsConfigurable"
      id="io.github.heisiar.composewizard.settings"
      displayName="Compose Multiplatform Wizard"/>
  </extensions>
</idea-plugin>

